<!--
  box_on_plane.xml: a 0.1 m cube of 1 kg dropped from 0.25 m onto a plane.

  Units are SI (m, kg, s, N). The cube's centre starts at z = 0.30 m, so its bottom face falls
  0.25 m, lands at t = 0.226 s at 2.21 m/s, and comes to rest on four corner contacts whose
  normal forces sum to m g = 9.81 N.

  Loaded by the slides (lib/mj.js, MuJoCo 3.14.0 WebAssembly) and by the notebooks (Python
  mujoco==3.14.0); tools/twins/mujoco.json checks that both engines step it to the same numbers.
  Everything not set here is a MuJoCo default: Euler integrator, pyramidal friction cone,
  impratio 1, solref "0.02 1", solimp "0.9 0.95 0.001", friction "1 0.005 0.0001".
-->
<mujoco model="box_on_plane">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <worldbody>
    <!-- Collision planes are infinite; size sets the drawn extent (1 m x 1 m, 0.05 m grid). -->
    <geom name="floor" type="plane" size="0.5 0.5 0.05" rgba="0.9 0.9 0.9 1"/>

    <body name="box" pos="0 0 0.3">
      <freejoint name="box"/>
      <!-- Half-sizes 0.05 m give a 0.1 m cube; mass 1 kg sets the density to 1000 kg/m^3. -->
      <geom name="box" type="box" size="0.05 0.05 0.05" mass="1" rgba="0.8 0.8 0.8 1"/>
    </body>
  </worldbody>
</mujoco>
